{
  "name": "dsh-plugin-antigravity-acp",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) plugin connecting Google Antigravity ACP runtime for Gemini 3.x coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./client": "./dsh/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "antigravity",
    "acp",
    "agent-client-protocol",
    "gemini",
    "agent"
  ],
  "author": "tanfeng",
  "license": "MIT",
  "files": [
    "dist",
    "dsh",
    "cordis.patch.yml",
    "runtime-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2"
  }
}
